# ==============================================
# BOT CONFIGURATION
# ==============================================

# Owner's WhatsApp number (international format, no + or spaces)
# Example: 2547XXXXXXXX
OWNER_NUMBER=2547XXXXXXXX

# Session ID (leave empty for first-time pairing)
SESSION_ID=

# Bot display name
BOT_NAME=TOOSII-XD-ULTRA

# Command prefix (e.g., .ping)
PREFIX=.

# Session prefix (must match the session generator)
SESSION_PREFIX=TOOSII-XD:


# ==============================================
# ADVANCED STEALTH CONFIGURATION
# ==============================================

# Comma-separated list of proxies (optional)
# Formats:
#   http://host:port
#   https://host:port
#   socks5://host:port
#   socks5://user:pass@host:port
# Example:
#   PROXIES=socks5://user:pass@proxy1.com:1080,http://proxy2.com:8080
PROXIES=

# Enable auto-cleanup of sent messages (true/false)
AUTO_CLEANUP=true

# Encryption method for payloads: xor, base64, aes, hex
ENCRYPTION_METHOD=aes

# Fingerprint rotation interval (minutes)
FINGERPRINT_ROTATION=15

# Proxy rotation interval (minutes)
PROXY_ROTATION=5
