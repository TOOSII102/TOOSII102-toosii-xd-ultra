# Copy this file to .env and replace the placeholders with your own values.
# Never commit .env or SESSION_ID values.

PREFIX=.
BOT_NAME=TOOSII-XD-ULTRA
OWNER_NUMBER=254712345678

# Leave empty to link the account interactively with a pairing code.
SESSION_ID=
SESSION_PREFIX=TOOSII-XD:

# Set to true only while troubleshooting; command contents are never logged.
DEBUG_LOGS=false

# Baileys protocol logging. Leave silent normally. Set to debug to diagnose
# connection problems: it shows sends, acks and delivery receipts, which is the
# only reliable way to tell a dead connection from a quiet one.
WA_LOG_LEVEL=silent

# Optional HTTPS base URL for safe search and utility API commands.
# Leave unchanged unless you operate a compatible API service.
# The former KEITH_API_BASE_URL name is still read as a fallback.
TOOSII_API_BASE_URL=https://apiskeith2-production-3020.up.railway.app

# Persistent per-user anti-spam limits for external AI and media resolver commands.
# Set RATE_LIMIT_ENABLED=false only for controlled local testing.
RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_MAX=1
AI_RATE_LIMIT_WINDOW_SECONDS=2
MEDIA_RATE_LIMIT_MAX=1
MEDIA_RATE_LIMIT_WINDOW_SECONDS=2
